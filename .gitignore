# ==============================================================================
# Nexvyn Port Studio - Public Git Ignore
# ==============================================================================

# Large packages and archives (GitHub 100 MB limit)
*.zip
*.7z
*.rar
*.tar.gz
*.tar.xz
*.iso
*.bin
*.vhd

# Switch and binary outputs
*.nro
*.elf
*.nacp
*.nca
*.nsp
*.xci
*.nxvapp
*.nxvmod
*.nxvmod.debug
*.so
*.dll
*.dylib
*.exe
*.o
*.obj
*.a

# Build, recompilation and intermediate folders
build/
build_*/
bin/
obj/
dist/
out/
target/
cmake-build-*/
.cache/
game/
work/
analysis/
src/recomp/gen/
src/recomp/gen_game/
/**/src/recomp/gen/
/**/src/recomp/gen_game/
/**/work/
/**/game/

# Local launcher (non-web)
/start.bat

# Copyrighted / large game assets
*.mix
*.mpq
*.wad
*.bsp
*.vpk
*.pak
*.bik
*.smk
*.csf

# Emulator, IDE and OS leftovers
.emulator_profile/
.vscode/
.idea/
*.swp
*.suo
*.user
Thumbs.db
Desktop.ini
.DS_Store

# Temporary and log files
*.log
*.tmp
_temp*
_move_temp*

# Studio personal data and SDK backups
_LocalData/
/_PortStudioMain/_SdkBackups/
/_PortStudioMain/_SdkCandidates/
__pycache__/
.port-studio-*/
# Upstream game template and sample archives tracked with the public SDK
!/_PortStudioMain/nexvyn_sdk/Languages/c/native-kit/sdk/native/templates/game/
!/_PortStudioMain/nexvyn_sdk/Samples/**/*.zip
/_RealesedBuilds/*
!/_RealesedBuilds/README.md
!/_RealesedBuilds/game/
!/_RealesedBuilds/software/
/_RealesedBuilds/game/*
/_RealesedBuilds/software/*
!/_RealesedBuilds/game/.gitkeep
!/_RealesedBuilds/software/.gitkeep

# Local scratch
_scratch/
scratch_*/
scratch_*.py
*.s
extracted_*.npdm
_PortStudioMain/_temp_nexvyn_repo/
_PortStudioMain/_SdkCandidates/
_PortStudioMain/_SdkBackups/
_PortStudioMain/_EmulatorCache/
.emulator_profile/
.emulator_profile.lock

# Emulator scenario runs (shots, logs, review.md) stay local evidence
**/screenshots/runs/

# Throwaway upstream clones for assessment
_PortStudioMain/tmp_*/

# Per-port emulator profiles (copies of the emulator data: keys, firmware, SD card)
.emulator_profile_*/

# Local debug output: ELF symbol dump
symbols.txt

# mm3 debugging scripts with fixed local Temp paths; not Studio tools
_PortStudioMain/tools/build_and_run_v7.py
_PortStudioMain/tools/check_status.py
_PortStudioMain/tools/clean_memory.py
_PortStudioMain/tools/clean_traces.py
