# Büyük Paketler ve Arşivler (GitHub 100MB Sınırı)
*.zip
*.7z
*.rar
*.tar.gz
*.tar.xz
*.iso
*.bin
*.vhd

# Switch & Binary Çıktıları
*.nro
*.elf
*.nacp
*.nca
*.nsp
*.xci
*.nxvapp
*.nxvmod
*.nxvmod.debug
*.so
*.dll
*.dylib
*.exe
*.o
*.obj
*.a

# Derleme, Recomp ve Ara Klasörler
build/
build_*/
bin/
obj/
dist/
out/
target/
cmake-build-*/
.cache/
game/
work/
analysis/
src/recomp/gen/
src/recomp/gen_game/
/**/src/recomp/gen/
/**/src/recomp/gen_game/
/**/work/
/**/game/

# Yerel Başlatıcı (Web harici)
/start.bat

# Telifli / Büyük Oyun Assetleri
*.mix
*.mpq
*.wad
*.bsp
*.vpk
*.pak
*.bik
*.smk
*.csf

# Emülatör & IDE & Sistem Kalıntıları
.emulator_profile/
.vscode/
.idea/
*.swp
*.suo
*.user
Thumbs.db
Desktop.ini
.DS_Store

# Geçici / Log Dosyaları
*.log
*.tmp
_temp*
_move_temp*

# Stüdyo kişisel verileri ve SDK yedekleri
_LocalData/
/_PortStudioMain/_SdkBackups/
/_PortStudioMain/_SdkCandidates/
__pycache__/
.port-studio-*/
/_RealesedBuilds/*
!/_RealesedBuilds/README.md
!/_RealesedBuilds/game/
!/_RealesedBuilds/software/
/_RealesedBuilds/game/*
/_RealesedBuilds/software/*
!/_RealesedBuilds/game/.gitkeep
!/_RealesedBuilds/software/.gitkeep
