  "experience": {
    "schema": 1,
    "profile": "rts",
    "input": {
      "touch": {
        "panSensitivity": {
          "default": 1.0,
          "min": 0.5,
          "max": 2.0
        },
        "invertPan": true
      },
      "edgeScroll": {
        "default": true,
        "rate": {
          "default": 4,
          "min": 1,
          "max": 6
        }
      },
      "gestures": {
        "two_finger_tap": "command",
        "pinch": null
      },
      "engineFacts": "Verified in port source (src/nx/main.c, launcher.cpp): two-finger drag pans the camera, long press and two-finger tap send a right click, nothing handles pinch. The mouse wheel is only forwarded as WM_MOUSEWHEEL. Not yet tested in the running game: whether Yuri's Revenge reacts to the wheel. Until tested, pinch uses the present method (port-side magnification).",
      "zoom": {
        "method": "none",
        "min": 1.0,
        "max": 1.0,
        "step": 0.25,
        "defaultOn": false,
        "evidence": "Emulator, 2026-11-23, skirmish map: injected pinch-out and pinch-in produced touch wheel +120 and -120 events through hle_input_wheel, and the camera did not change between ra2_map_start.png and ra2_map_pinch_in.png. Yuri's Revenge ignores the mouse wheel for zoom. Port-side magnification (method present) is not built."
      },
      "scroll": {
        "twoFingerDragInSidebar": "wheel",
        "note": "A two-finger drag that starts in the right 20% of the screen sends the wheel (lists and the sidebar); elsewhere it pans the camera."
      },
      "unsupported": [
        "camera_zoom"
      ]
    },
    "performance": {
      "autoDockDefault": false,
      "notes": "Frame rate on device not yet measured. Preset caps apply until measured. Values mirror src/nx/launcher.cpp defaults."
    },
    "launcher": {
      "sections": [
        "data",
        "video",
        "controls",
        "mods",
        "help"
      ]
    }
  },
