+/* Minimal 3x5 bitmap font for digits 0-9 and 'F','P','S' (0 dependencies) */
+static void draw_fps_hud(SDL_Renderer *ren, int ww, int fps) {
+    static const uint16_t k_glyphs[14] = {
+        0x7B6F, /* 0 */ 0x2492, /* 1 */ 0x73E7, /* 2 */ 0x73CF, /* 3 */
+        0x5BC9, /* 4 */ 0x79CF, /* 5 */ 0x79EF, /* 6 */ 0x7249, /* 7 */
+        0x7BEF, /* 8 */ 0x7BCF, /* 9 */ 0x79E4, /* F */ 0x7BE4, /* P */
+        0x79CF, /* S */ 0x0000  /* space */
+    };
+    char txt[16];
+    snprintf(txt, sizeof txt, "%d FPS", fps);
+    int len = (int)strlen(txt);
+    int sc = ww >= 1600 ? 4 : 3;
+    int cw = 4 * sc, ch = 5 * sc;
+    int pad = sc * 2;
+    int bw = len * cw + pad * 2 - sc;
+    int bh = ch + pad * 2;
+    int bx = ww - bw - 14;
+    int by = 14;
+
+    SDL_SetRenderDrawBlendMode(ren, SDL_BLENDMODE_BLEND);
+    SDL_SetRenderDrawColor(ren, 12, 14, 18, 195);
+    SDL_Rect bg = { bx, by, bw, bh };
+    SDL_RenderFillRect(ren, &bg);
+    SDL_SetRenderDrawColor(ren, 255, 255, 255, 50);
+    SDL_RenderDrawRect(ren, &bg);
+
+    if (fps >= 45)      SDL_SetRenderDrawColor(ren, 46, 204, 113, 255);
+    else if (fps >= 25) SDL_SetRenderDrawColor(ren, 243, 156, 18, 255);
+    else                SDL_SetRenderDrawColor(ren, 231, 76, 60, 255);
+
+    for (int i = 0; i < len; i++) {
+        int gi = 13;
+        char c = txt[i];
+        if (c >= '0' && c <= '9') gi = c - '0';
+        else if (c == 'F') gi = 10;
+        else if (c == 'P') gi = 11;
+        else if (c == 'S') gi = 12;
+        uint16_t bits = k_glyphs[gi];
+        int gx = bx + pad + i * cw;
+        int gy = by + pad;
+        for (int r = 0; r < 5; r++) {
+            for (int col = 0; col < 3; col++) {
+                if (bits & (1u << (14 - (r * 3 + col)))) {
+                    SDL_Rect px = { gx + col * sc, gy + r * sc, sc, sc };
+                    SDL_RenderFillRect(ren, &px);
+                }
+            }
+        }
+    }
